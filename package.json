{
  "name": "@lyra-forge/leyline",
  "version": "0.5.0",
  "description": "The working parts of tools where people and coding agents share a document: a chat panel, agent providers, conversations, routines, history, proposals, activity, threads and profiles.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/run.mjs",
    "check": "for f in server/*.mjs server/providers/*.mjs src/*.mjs test/*.mjs test/fixtures/*.mjs bench/*.mjs bench/fixtures/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./ui/*": "./src/ui/*.tsx",
    "./theme.css": "./src/theme.css",
    "./dock": "./src/dock.tsx",
    "./activity": "./src/activity.tsx",
    "./server/rpc": "./server/codex-rpc.mjs",
    "./server/routines": "./server/routine-bank.mjs",
    "./routines": "./src/routines.mjs",
    "./routine-menu": "./src/routine-menu.tsx",
    "./server/providers": "./server/providers/index.mjs",
    "./server/providers/codex-app-server": "./server/providers/codex-app-server.mjs",
    "./server/providers/cli-oneshot": "./server/providers/cli-oneshot.mjs",
    "./server/providers/http-chat": "./server/providers/http-chat.mjs",
    "./server/conversations": "./server/conversations.mjs",
    "./server/telemetry": "./server/telemetry.mjs",
    "./server/commands": "./server/commands.mjs",
    "./server/routine-set": "./server/routine-set.mjs",
    "./server/history": "./server/history.mjs",
    "./server/proposals": "./server/proposals.mjs",
    "./server/activity": "./server/activity.mjs",
    "./server/threads": "./server/threads.mjs",
    "./server/profiles": "./server/profiles.mjs",
    "./server/worklog": "./server/worklog.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "server",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lavallee/leyline.git"
  },
  "homepage": "https://github.com/lavallee/leyline#readme",
  "bugs": {
    "url": "https://github.com/lavallee/leyline/issues"
  }
}
